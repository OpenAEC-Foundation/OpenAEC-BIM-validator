{
  "name": "ifc-viewer-poc",
  "version": "0.1.0",
  "description": "That Open Engine IFC Viewer - Proof of Concept for Phase 0 Research",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "serve": "python -m http.server 8080",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@thatopen/components": "^3.3.3",
    "@thatopen/components-front": "^3.3.3",
    "@thatopen/fragments": "^3.3.6",
    "camera-controls": "^3.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^4.7.2",
    "three": "^0.183.2",
    "web-ifc": "^0.0.77",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.4.5",
    "vite": "^5.0.0",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "ifc",
    "bim",
    "3d-viewer",
    "that-open-engine",
    "webgl"
  ],
  "author": "3BM Research",
  "license": "MIT"
}
