{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "BIM Validator",
  "version": "0.1.0",
  "identifier": "com.openaec.bim-validator",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -- --port 5173 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "BIM Validator",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "server/**/*",
      "WebView2Loader.dll"
    ],
    "fileAssociations": [
      {
        "ext": ["ifc"],
        "name": "IFC Model",
        "description": "IFC building model",
        "role": "Editor",
        "mimeType": "application/x-step"
      },
      {
        "ext": ["ifcx"],
        "name": "IFCx Model",
        "description": "IFCx building model",
        "role": "Editor"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
